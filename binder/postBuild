#!/bin/bash
set -e

SCALA_VERSION=2.12.10 ALMOND_VERSION=0.9.1

# Install coursier (pinned to v2.0.16 for Java 8 compatibility)
curl -fLo coursier https://github.com/coursier/coursier/releases/download/v2.0.16/coursier
chmod +x coursier

# Install almond
./coursier bootstrap \
    -r jitpack \
    -i user -I user:sh.almond:scala-kernel-api_$SCALA_VERSION:$ALMOND_VERSION \
    sh.almond:scala-kernel_$SCALA_VERSION:$ALMOND_VERSION \
    --sources --default=true \
    -o almond
./almond --install
rm -f coursier almond

# Install custom Javascript for solutions
mkdir -p ~/.jupyter/custom
cp source/custom.js ~/.jupyter/custom/custom.js

# Pre-execute 0_demo.ipynb to cache Chisel dependencies into the image
jupyter nbconvert --to notebook --execute --ExecutePreprocessor.timeout=600 --output=/tmp/0_demo 0_demo.ipynb
rm -rf /tmp/0_demo.ipynb diagrams
